# Environment Configuration for Web Application
# Copy this file to .env.local and fill in the values

# Node Environment
NODE_ENV=development

# Application URL
# Used for auth callbacks and email confirmations
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API URL (FastAPI backend)
# URL of the FastAPI backend for newsletter generation
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Configuration (Client-side - safe to expose)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Configuration (Server-side - keep secret!)
# WARNING: Never commit this key or expose it to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Service (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Internal API Secret
# Generate a secure random string (min 32 characters)
# Example: openssl rand -base64 32
API_SECRET_KEY=your-secret-key-at-least-32-characters-long
