# Environment Configuration for FastAPI Backend
# Copy this file to .env and fill in the values

# Supabase Configuration (for database access)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic API Key (for Claude LLM)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Tavily API Key (for web search)
# Get your API key from: https://tavily.com/
TAVILY_API_KEY=tvly-your-api-key-here

# LangSmith Configuration (for agent tracking and observability)
# Get your API key from: https://smith.langchain.com/
LANGCHAIN_API_KEY=lsv2_pt_your-api-key-here
LANGSMITH_API_KEY=lsv2_pt_your-api-key-here  # Alternative name
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=newsletter-automation

# Model Configuration (optional)
# Default: claude-sonnet-4-5-20250929
MODEL_NAME=claude-sonnet-4-5-20250929
