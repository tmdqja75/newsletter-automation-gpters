{
  "buildCommand": "cd web && npm run build",
  "devCommand": "cd web && npm run dev",
  "installCommand": "cd web && npm install",
  "framework": "nextjs",
  "outputDirectory": "web/.next",
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-newsletters",
      "schedule": "0 0 * * *"
    }
  ]
}
